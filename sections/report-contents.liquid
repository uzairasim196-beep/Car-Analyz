<section class="section soft"><div class="container"><div class="section-heading"><span class="eyebrow">{% if section.settings.services_eyebrow != blank %}{{ section.settings.services_eyebrow | escape }}{% else %}{{ 'copy.services_eyebrow' | t }}{% endif %}</span><h2>{% if section.settings.services_title != blank %}{{ section.settings.services_title | escape }}{% else %}{{ 'copy.services_title' | t }}{% endif %} <span>{% if section.settings.services_accent != blank %}{{ section.settings.services_accent | escape }}{% else %}{{ 'copy.services_accent' | t }}{% endif %}</span></h2><p>{% if section.settings.services_description != blank %}{{ section.settings.services_description | escape }}{% else %}{{ 'copy.services_description' | t }}{% endif %}</p></div><div class="service-grid"><article class="service-card"><div class="service-icon">{% if section.settings.image_1 != blank %}{{ section.settings.image_1 | image_url: width: 1200 | image_tag: loading: 'lazy' }}{% else %}<img class="" src="{{ 'service-1.webp' | asset_url }}" alt="{{ 'copy.alt_service_1' | t }}" width="1200" height="800" loading="lazy">{% endif %}</div><h3>{% if section.settings.service_1_title != blank %}{{ section.settings.service_1_title | escape }}{% else %}{{ 'copy.service_1_title' | t }}{% endif %}</h3><p>{% if section.settings.service_1_body != blank %}{{ section.settings.service_1_body | escape }}{% else %}{{ 'copy.service_1_body' | t }}{% endif %}</p></article><article class="service-card"><div class="service-icon">{% if section.settings.image_2 != blank %}{{ section.settings.image_2 | image_url: width: 1200 | image_tag: loading: 'lazy' }}{% else %}<img class="" src="{{ 'service-2.webp' | asset_url }}" alt="{{ 'copy.alt_service_2' | t }}" width="1200" height="800" loading="lazy">{% endif %}</div><h3>{% if section.settings.service_2_title != blank %}{{ section.settings.service_2_title | escape }}{% else %}{{ 'copy.service_2_title' | t }}{% endif %}</h3><p>{% if section.settings.service_2_body != bl