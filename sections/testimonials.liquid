{% if section.blocks.size > 0 or section.settings.show_placeholder_reviews != false or request.design_mode %}
<section class="section" id="testimonials">
  <div class="container">
    <div class="section-heading">
      <span class="eyebrow">{{ 'copy.reviews_eyebrow' | t }}</span>
      <h2>{{ 'copy.reviews_title' | t }} <span>{{ 'copy.reviews_accent' | t }}</span></h2>
    </div>
    <div class="review-grid">
      {% for block in section.blocks %}
        <article class="review-card" {{ block.shopify_attributes }}>
          <div class="stars" aria-label="{{ block.settings.rating }} {{ 'copy.out_of_five' | t }}">{% for i in (1..block.settings.rating) %}★{% endfor %}</div>
          <p>{{ block.settings.quote | escape }}</p>
          <div class="review-user">
            {% if block.settings.avatar != blank %}
              {{ block.settings.avatar | image_url: width: 100 | image_tag: loading: 'lazy', alt: block.settings.name }}
            {% else %}
              <span class="review-initial" aria-hidden="true">{{ block.settings.name | slice: 0 | escape }}</span>
            {% endif %}
            <div><strong>{{ block.settings.name | escape }}</strong><small>{{ block.settings.caption | escape }}</small></div>
          </div>
        </article>
      {% else %}
        {% if section.settings.show_placeholder_reviews != false %}
          {% for i in (1..3) %}
            {% liquid
              assign name_key = 'copy.review_sample_name_' | append: i
              assign quote_key = 'copy.review_sample_quote_' | append: i
              assign sample_name = name_key | t
            %}
            <article class="review-card">
              <div class="stars" aria-label="5 {{ 'copy.out_of_five' | t }}">★★★★★</div>
              <p>{{ quote_key | t }}</p>
              <div class="review-user">
                <span class="review-initial" aria-hidden="true">{{ sample_name | slice: 0 }}</span>
                <div><strong>{{ sample_name }}</strong><small>{{ 'copy.review_sample_caption' | t }}</small></div>
              </div>
            </article>
          {% endfor %}
        {% elsif request.design_mode %}
          <p class="editor-note">{{ 'copy.reviews_editor' | t }}</p>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "paragraph",
      "content": "Replace the sample cards with genuine customer reviews using Add block. Edit the text, customer name, description, photo and rating for each card."
    },
    {
      "type": "checkbox",
      "id": "show_placeholder_reviews",
      "label": "Show sample cards when no reviews are added",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "quote": "Add a customer review about how the boat history report helped them make a more informed purchase.",
            "name": "Boat buyer",
            "caption": "Sample review",
            "rating": 5
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "Add a customer review about their experience checking ownership records and important vessel details.",
            "name": "Boat owner",
            "caption": "Sample review",
            "rating": 5
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "Add a customer review about the clarity of their report and the support they received from your team.",
            "name": "Marine professional",
            "caption": "Sample review",
            "rating": 5
          }
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Customer review",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review text",
          "default": "Add a customer review about how the boat history report helped them make a more informed purchase."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer name",
          "default": "Boat buyer"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Customer description",
          "default": "Sample review"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Customer image"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ]
}
{% endschema %}
