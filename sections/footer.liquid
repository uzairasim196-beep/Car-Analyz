<footer class="site-footer"><div class="container"><div class="footer-grid"><div><a class="footer-brand footer-brand-logo" href="{{ routes.root_url }}">{% if settings.logo != blank %}{{ settings.logo | image_url: width: 640 | image_tag: class: 'footer-logo', widths: '320, 640', loading: 'lazy', alt: settings.brand_name }}{% else %}<img class="footer-logo" src="{{ 'checkhinhistory-logo.png' | asset_url }}" alt="{{ 'copy.logo_alt' | t }}" width="2172" height="724" loading="lazy">{% endif %}</a><p>{{ 'copy.footer_about' | t }}</p></div><div><h3>{{ 'copy.resources' | t }}</h3><a href="{{ routes.root_url }}">{{ 'copy.nav_home' | t }}</a><a href="{{ routes.root_url }}#how-to-order">{{ 'copy.nav_how' | t }}</a>{% if settings.show_reviews %}<a href="{{ routes.root_url }}#testimonials">{{ 'copy.nav_reviews' | t }}</a>{% endif %}<a href="{{ routes.root_url }}#faq">{{ 'copy.nav_faq' | t }}</a><a href="{{ settings.contact_url }}">{{ 'copy.nav_contact' | t }}</a></div><div><h3>{{ 'copy.legal' | t }}</h3>{% for policy in shop.policies %}{% if policy != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}<a href="{{ routes.cart_url }}">{{ 'copy.your_cart' | t }}</a></div><div><h3>{{ 'copy.contact_heading' | t }}</h3><a class="footer-contact" href="mailto:{{ settings.email | escape }}">{% render 'icon', name: 'mail' %}{{ settings.email | escape }}</a><p class="footer-contact">{% render 'icon', name: 'clock' %}{{ settings.support_label | escape }}</p><p class="footer-contact">{% render 'icon', name: 'document' %}{{ settings.delivery_label | escape }}</p></div></div><div class="footer-bottom"><span>© {{ 'now' | date: '%Y' }} {{ settings.brand_name | escape }}. {{ 'copy.rights' | t }}</span><span>{% for policy in shop.policies limit: 2 %}{% if policy != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}</span></div></div></footer>
{% schema %}
{
  "name": "Footer",
  "settings": [],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}