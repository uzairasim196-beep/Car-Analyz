<!doctype html><html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{% if request.page_type == 'index' %}{{ settings.brand_name | escape }}{% else %}{{ page_title | escape }} | {{ settings.brand_name | escape }}{% endif %}</title>{% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}<link rel="canonical" href="{{ canonical_url }}">{{ 'theme.css' | asset_url | stylesheet_tag }}{{ content_for_header }}<script src="{{ 'theme.js' | asset_url }}" defer></script>{% style %}:root{--blue:{{ settings.primary_color }};--coral:{{ settings.accent_color }};}{% endstyle %}</head><body><a class="skip-link" href="#MainContent">{{ 'copy.skip' | t }}</a>{% section 'header' %}<main id="MainContent">{{ content_for_layout }}</main>{% section 'footer' %}</body></html>